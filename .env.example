# Exchange Configuration
BOT_EXCHANGE_ID=binance
BOT_API_KEY=your_api_key_here
BOT_API_SECRET=your_api_secret_here
BOT_TESTNET=true

# Trading Configuration
BOT_MODE=paper          # live | paper | backtest
BOT_SYMBOL=BTC/USDT:USDT
BOT_TIMEFRAME=15m
BOT_LEVERAGE=5
BOT_STRATEGY_NAME=multi_signal   # multi_signal | scalping

# Risk Management
BOT_MAX_POSITION_PCT=0.02       # 2% of balance per trade
BOT_STOP_LOSS_PCT=0.015         # 1.5% stop loss
BOT_TAKE_PROFIT_PCT=0.03        # 3.0% take profit (R:R = 2:1)
BOT_TRAILING_STOP_PCT=0.01      # 1% trailing stop
BOT_MAX_DAILY_LOSS_PCT=0.05     # 5% max daily loss
BOT_MAX_OPEN_POSITIONS=3
BOT_MAX_DRAWDOWN_PCT=0.10       # 10% max total drawdown → emergency stop

# Strategy Sensitivity
BOT_MIN_SIGNAL_SCORE=0.6        # Minimum combined signal score to enter

# Polling
BOT_POLL_INTERVAL_SECONDS=30

# Logging
BOT_LOG_LEVEL=INFO
BOT_LOG_FILE=logs/bot.log

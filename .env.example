# Exchange Configuration
BOT_EXCHANGE_ID=binance
BOT_API_KEY=your_api_key_here
BOT_API_SECRET=your_api_secret_here
BOT_TESTNET=true

# Trading Configuration
BOT_MODE=paper          # live | paper | backtest
BOT_SYMBOL=BTC/USDT:USDT
BOT_TIMEFRAME=15m
BOT_LEVERAGE=5
BOT_STRATEGY_NAME=multi_signal   # multi_signal | scalping

# Risk Management
BOT_MAX_POSITION_PCT=0.02       # 2% of balance per trade
BOT_STOP_LOSS_PCT=0.015         # 1.5% stop loss (fallback if ATR unavailable)
BOT_TAKE_PROFIT_PCT=0.02        # 2.0% take profit (fallback)
BOT_TRAILING_STOP_PCT=0.008     # 0.8% trailing stop
BOT_ATR_SL_MULTIPLIER=1.5      # ATR x1.5 for dynamic stop-loss
BOT_ATR_TP_MULTIPLIER=2.0      # ATR x2.0 for dynamic take-profit
BOT_MAX_DAILY_LOSS_PCT=0.05     # 5% max daily loss
BOT_MAX_OPEN_POSITIONS=3
BOT_MAX_DRAWDOWN_PCT=0.10       # 10% max total drawdown → emergency stop

# Strategy Sensitivity
BOT_MIN_SIGNAL_SCORE=0.3        # Minimum combined signal score to enter
BOT_REGIME_FILTER=true          # Penalise counter-trend trades

# Polling
BOT_POLL_INTERVAL_SECONDS=30

# Logging
BOT_LOG_LEVEL=INFO
BOT_LOG_FILE=logs/bot.log
